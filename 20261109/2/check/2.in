  t0 = Triangle((1, 1), (2, 2), (3, 3))
t1 = Triangle((0, 0), (10, 0), (0, 10))
t2 = Triangle((20, 20), (21, 20), (20, 21))
print(f"{bool(t0)} {bool(t1)} {round(abs(t0), 3)} {round(abs(t1), 3)}")
print(f"{t0 in t1} {t1 in t0} {t0 in t0} {t2 in t1}")
print(f"{t0 & t1} {t1 & t0} {t1 & t2} {t0 & t2}")
