from itertools import permutations
class A: pass
class B: pass
class C(A, B): pass
class D(B, A): pass


classes = (A, B, C, D)
res = 0
for a, b in permutations(classes, 2):
    try:
        class E(a, b): pass
        print(a, b)
        res += 1
    except TypeError as E:
        print(E)
    else:
        print("OK")

print(res)
